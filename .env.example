# Copy to .env — never commit real values.
PORT=4021

# Wallet that receives USDC payments (x402 payTo)
PAY_TO=0xea6c6d0361a758e51004fc5b0c31a3c6b2408858

# HMAC secret used to sign usage receipts. Generate: openssl rand -hex 32
RECEIPT_SECRET=change-me

# Upstream paid endpoints Metered wraps (your live services)
UPSTREAM_EXTRACT=https://x402-extract-wg5z.onrender.com/extract
UPSTREAM_EXTRACT_FIELDS=https://x402-extract-wg5z.onrender.com/extract-fields

# Default per-wallet daily spend cap in USDC (agents can raise via registry request)
DEFAULT_DAILY_CAP_USDC=5
